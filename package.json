{
  "name": "aether-dock",
  "version": "0.1.1",
  "private": true,
  "description": "AetherDock 桌面应用",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "concurrently -k \"vite --port 5174 --strictPort\" \"wait-on http://localhost:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --publish never"
  },
  "build": {
    "appId": "com.aetherdock.app",
    "productName": "AetherDock",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "machho18",
        "repo": "aether-dock"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "electron/assets/tray-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@vueuse/core": "^13.7.0",
    "electron-updater": "^6.8.9",
    "lottie-web": "^5.13.0",
    "tailwindcss": "^4.1.12",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.3",
    "wait-on": "^8.0.3"
  }
}
